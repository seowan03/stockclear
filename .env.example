# Copy this file to .env for local development and replace placeholders locally.
ENV=development

DATABASE_URL=
DB_HOST=
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_PORT=21018
DB_CHARSET=utf8mb4

OPENAI_API_KEY=replace-with-openai-key
KAKAO_CLIENT_ID=replace-with-kakao-client-id
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
KAKAO_REDIRECT_URI=http://127.0.0.1:8000/api/auth/kakao/callback
SESSION_SECRET_KEY=replace-with-long-random-secret